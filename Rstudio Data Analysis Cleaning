    str_to_lower(over_time) %in% c("yes", "2") ~ "Yes",
    str_to_lower(over_time) %in% c("no", "1")  ~ "No",
    TRUE ~ NA_character_
  ))

# ── 6c. gender ───────────────────────────────────────────────
