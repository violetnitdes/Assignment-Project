    str_to_lower(education_field) %in%
      c("td", "technical degree", "technical")  ~ "Technical Degree",
    str_to_lower(education_field) %in%
      c("hr", "human resources")                ~ "Human Resources",
    str_to_lower(education_field) %in%
      c("other", "others")                      ~ "Other",
    TRUE ~ NA_character_
  ))

# ── 6h. job_.role ──────────────────────────────────────────────
# Variants found in Step 2b: "healthcare rep",
#   "healthcare representative","hr","human resources",
