# Helper: compute attrition % by any variable x manager_tenure
# Avoids copy-pasting the same pipeline for each variable.
make_interact_summary <- function(data, var_col) {
  data %>%
    group_by(manager_tenure, across(all_of(var_col)), attrition) %>%
    summarise(Count = n(), .groups = "drop") %>%
    group_by(manager_tenure, across(all_of(var_col))) %>%
    mutate(
      Total      = sum(Count),
      Percentage = round(Count / Total * 100, 1)
    ) %>%
    ungroup() %>%
    filter(attrition == "Yes")
}


