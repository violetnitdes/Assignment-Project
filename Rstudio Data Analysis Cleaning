# --- 3-2A: Chi-Square Test of Independence ---
# Tests whether attrition is independent of each
# satisfaction/involvement variable.
# A p-value < 0.05 indicates a statistically significant association.

cat("--- Chi-Square Test: relationship_satisfaction vs Attrition ---\n")
tbl_rel <- table(df$relationship_satisfaction, df$attrition)
chi_rel <- chisq.test(tbl_rel)
print(chi_rel)
cat("Conclusion:", ifelse(chi_rel$p.value < 0.05,
                          "Significant association (p < 0.05)",
                          "No significant association (p >= 0.05)"), "\n\n")

cat("--- Chi-Square Test: environment_satisfaction vs Attrition ---\n")
tbl_env <- table(df$environment_satisfaction, df$attrition)
chi_env <- chisq.test(tbl_env)
print(chi_env)
cat("Conclusion:", ifelse(chi_env$p.value < 0.05,
                          "Significant association (p < 0.05)",
                          "No significant association (p >= 0.05)"), "\n\n")

cat("--- Chi-Square Test: job_involvement vs Attrition ---\n")
tbl_job <- table(df$job_involvement, df$attrition)
chi_job <- chisq.test(tbl_job)
print(chi_job)
cat("Conclusion:", ifelse(chi_job$p.value < 0.05,
                          "Significant association (p < 0.05)",
                          "No significant association (p >= 0.05)"), "\n\n")


# --- 3-2B: Point-Biserial Correlation + Mann-Whitney U Test ---
# Point-Biserial measures the linear relationship between the
# continuous years_with_curr_manager and binary attrition (0/1).
# Mann-Whitney U is applied as a non-parametric complement
# given the skewed distribution observed in Analysis 3-1B.

cat("--- Point-Biserial Correlation: years_with_curr_manager vs Attrition ---\n")
pb_corr <- cor.test(df$years_with_curr_manager, df$attrition_bin,
                    method = "pearson")
print(pb_corr)

r_value <- round(pb_corr$estimate, 4)

interpret_r <- function(r) {
  r <- abs(r)
  if (r < 0.1)      return("Negligible")
  else if (r < 0.3) return("Small")
  else if (r < 0.5) return("Moderate")
  else              return("Strong")
}

cat("Correlation coefficient (r):", r_value, "\n")
cat("Effect Size Interpretation  :", interpret_r(r_value), "\n")
cat("Conclusion:", ifelse(pb_corr$p.value < 0.05,
                          "Significant correlation (p < 0.05)",
                          "No significant correlation (p >= 0.05)"), "\n")
cat("Direction:", ifelse(pb_corr$estimate < 0,
                         "Negative - more years with manager = lower attrition risk",
                         "Positive - more years with manager = higher attrition risk"),
    "\n\n")

cat("--- Mann-Whitney U Test: years_with_curr_manager vs Attrition ---\n")
mw_test <- wilcox.test(years_with_curr_manager ~ attrition, data = df)
print(mw_test)
cat("Conclusion:", ifelse(mw_test$p.value < 0.05,
                          "Significant difference between groups (p < 0.05)",
                          "No significant difference between groups (p >= 0.05)"),
    "\n\n")


