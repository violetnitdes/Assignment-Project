  ))

# ── 6d. marital_status ────────────────────────────────────────
# Variants found in Step 2b: "divorced","married","single"
# Dataset description: 1=Divorced, 2=Married, 3=Single
df <- df %>%
  mutate(marital_status = case_when(
    str_to_lower(marital_status) == "single"   ~ "Single",
    str_to_lower(marital_status) == "married"  ~ "Married",
