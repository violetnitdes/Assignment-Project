# ============================================================
# FEATURE ENGINEERING – Derived Stagnation Variables
# ============================================================
# These mutated variables are used across ALL four analyses.
#
# stagnation_score:
#   Combined raw measure of career stagnation.
#   Higher score = longer stuck with no role change or promotion.
#   Formula: years_in_current_role + years_since_last_promotion
#
# stagnation_category:
#   Bucketed version of stagnation_score for easier interpretation.
#   Low    (0-4)  : Recently promoted or in role, low stagnation risk
#   Medium (5-9)  : Moderate stagnation, monitoring recommended
#   High   (10+)  : Extended stagnation, high attrition risk
#
# ============================================================

df <- df %>%
  mutate(
    stagnation_score    = years_in_current_role + years_since_last_promotion,
    stagnation_category = case_when(
      stagnation_score <= 4  ~ "Low",
      stagnation_score <= 9  ~ "Medium",
      TRUE                   ~ "High"
    )
  )

# Set factor order for stagnation_category so plots render logically
df$stagnation_category <- factor(
  df$stagnation_category,
  levels = c("Low", "Medium", "High")
)

