n_removed <- n_before - nrow(df)

cat("=== STEP 7: Duplicate rows ===\n")
cat("Rows before:", n_before,  "\n")
cat("Rows after :", nrow(df),  "\n")
cat("Removed    :", n_removed, "\n\n")


# ============================================================
# STEP 8 – Replace missing values (NA imputation)
# ============================================================
# Lab guideline:
#   Numeric columns     -> median()
#   Categorical columns -> mode (most frequent value)
#
# Some columns use GROUPED imputation because their values are logically 
# dependent on other columns.
# ORDER MATTERS – columns used as grouping variables must be imputed BEFORE the 
# columns that depend on them:
#
#   1. performance_rating  (used to group percent_salary_hike)
#   2. job_role            (grouped by department + job_level)
#   3. job_level           (grouped by department + job_role)
#   4. percent_salary_hike  (grouped by performance_rating)
#   5. monthly_income      (grouped by job_level)
#   6. stock_option_level   (grouped by job_level)
#   7. education_field     (grouped by department + job_role)
#   8. all other numeric  -> global median
#   9. all other categorical -> global mode
#  10. final fallback     -> catch any remaining NAs
# ============================================================

# Helper: compute statistical mode for a character vector
get_mode <- function(x) {
  x  <- x[!is.na(x)]
  ux <- unique(x)
  ux[which.max(tabulate(match(x, ux)))]
}

# ── 8a. performance_rating – global median ────────────────────
# Imputed first; used as group key for percent_salary_hike in Step 8e.
# round() ensures the result is a valid integer level (1–4) for factor conversion.
df <- df %>%
  mutate(performance_rating = ifelse(
    is.na(performance_rating),
    round(median(performance_rating, na.rm = TRUE)),
    performance_rating))

cat("STEP 8a – performance_rating : MEDIAN global (imputed first,\n")
cat("          used as group key for percent_salary_hike)\n")

# ── 8b. department – mode grouped by job_role ─────────────────
# department must be imputed before job_role since job_role
# uses department as a grouping key in Step 8c.
df <- df %>%
  group_by(job_role) %>%
  mutate(department = coalesce(department, get_mode(department))) %>%
  ungroup() %>%
  
  # Step 3: Global fallback just in case Job Role was also completely blank
  mutate(department = coalesce(department, get_mode(department)))

cat("STEP 8b – department        : MODE grouped by job_role\n")

# ── 8c. job_role – mode grouped by department + job_level ──────
# job_role depends on BOTH department AND job_level.
# e.g. R&D + Level 1 -> Research Scientist
#      Sales + Level 2 -> Sales Executive

# Primary: department + job_level group
df <- df %>%
  group_by(department, job_level) %>%
  mutate(job_role = ifelse(
    is.na(job_role), get_mode(job_role), job_role)) %>%
  ungroup()

# Fallback 1: department only (if job_level also blank)
df <- df %>%
  group_by(department) %>%
  mutate(job_role = ifelse(
    is.na(job_role), get_mode(job_role), job_role)) %>%
  ungroup()

# Fallback 2: global mode
df <- df %>%
  mutate(job_role = ifelse(
    is.na(job_role), get_mode(job_role), job_role))

cat("STEP 8c – job_role           : MODE grouped by department + job_level\n")

# ── 8d. job_level – median grouped by department + job_role ────
# job_role already filled above so this grouping is reliable.
# e.g. Manager -> level 4-5, Lab Technician -> level 1

df <- df %>%
  group_by(department, job_role) %>%
  mutate(job_level = ifelse(
    is.na(job_level), round(median(job_level, na.rm = TRUE)), job_level)) %>%
  ungroup()

# Fallback: global median
df <- df %>%
  mutate(job_level = ifelse(
    is.na(job_level), round(median(job_level, na.rm = TRUE)), job_level))

cat("STEP 8d – job_level          : MEDIAN grouped by department + job_role\n")

# ── 8e. percent_salary_hike – mode grouped by performance_rating ─
# Hike % is directly tied to performance review rating.
# performance_rating already imputed in Step 8b.
df <- df %>%
  group_by(performance_rating) %>%
  mutate(percent_salary_hike = ifelse(
    is.na(percent_salary_hike),
    median(percent_salary_hike, na.rm = TRUE),    
    percent_salary_hike)) %>%
  ungroup()

cat("STEP 8e – percent_salary_hike : MODE grouped by performance_rating\n")

# ── 8f. monthly_income – median grouped by job_level ───────────
# Correlation with job_level r = 0.69
# Level 1 median ~ 2,859  vs  Level 5 median ~ 19,094
# Global median (4,998) would be wrong for Level 4/5 employees
df <- df %>%
  group_by(job_level) %>%
  mutate(monthly_income = ifelse(
    is.na(monthly_income),
    median(monthly_income, na.rm = TRUE),
    monthly_income)) %>%
  ungroup()

cat("STEP 8f – monthly_income     : MEDIAN grouped by job_level\n")

# ── 8g. stock_option_level – mode grouped by job_level ──────────
# Level 1-2 predominantly StockOption 0
# Level 3-5 predominantly StockOption 1
df <- df %>%
  group_by(job_level) %>%
  mutate(stock_option_level = ifelse(
    is.na(stock_option_level), get_mode(stock_option_level), stock_option_level)) %>%
  ungroup()

# Fallback: global mode
df <- df %>%
  mutate(stock_option_level = ifelse(
    is.na(stock_option_level), get_mode(stock_option_level), stock_option_level))

cat("STEP 8g – stock_option_level  : MODE grouped by job_level\n")

# ── 8h. education_field – mode grouped by department + job_role
# education_field is linked to both department and job role.
# e.g. R&D  + Lab Technician  -> Life Sciences
#      Sales + Sales Executive -> Marketing (mode = 122)
#      HR   + Human Resources  -> Human Resources

# Primary: department + job_role group
df <- df %>%
  group_by(department, job_role) %>%
  mutate(education_field = ifelse(
    is.na(education_field),
    get_mode(education_field),
    education_field)) %>%
  ungroup()

# Fallback 1: department only
df <- df %>%
  group_by(department) %>%
  mutate(education_field = ifelse(
    is.na(education_field),
    get_mode(education_field),
    education_field)) %>%
  ungroup()

# Fallback 2: global mode (Life Sciences)
df <- df %>%
  mutate(education_field = ifelse(
    is.na(education_field),
    get_mode(education_field),
    education_field))

cat("STEP 8h – education_field    : MODE grouped by department + job_role\n")

# ── 8i. remaining likert / count columns – median ────────────
# Likert scales (e.g. 1-4, 1-5) and count columns use median
# to stay within the valid integer range of the scale.
# Note: performance_rating already handled in Step 8a (excluded here).
other_numeric <- c("education", "job_involvement",
                   "relationship_satisfaction", "work_life_balance",
                   "num_companies_worked", "training_times_last_year")

df <- df %>%
  mutate(across(all_of(other_numeric),
                ~ ifelse(is.na(.), round(median(., na.rm = TRUE)), .)))

cat("STEP 8i – other numeric     : MEDIAN global\n")

# ── 8i2. job_satisfaction & environment_satisfaction – mode ────
df <- df %>%
  mutate(
    job_satisfaction         = ifelse(is.na(job_satisfaction),
                                      get_mode(job_satisfaction), job_satisfaction),
    environment_satisfaction = ifelse(is.na(environment_satisfaction),
                                      get_mode(environment_satisfaction), environment_satisfaction)
  )

cat("STEP 8i2 – job_satisfaction & environment_satisfaction : MODE global\n")

# ── 8j. gender – "Prefer Not to Say" for blank ───────────────
df <- df %>%
  mutate(gender = ifelse(is.na(gender), "Prefer Not to Say", gender))

cat("STEP 8j – gender            : NAs filled with 'Prefer Not to Say'\n")

# ── 8k. marital_status – "Prefer Not to Say" for blank ────────
df <- df %>%
  mutate(marital_status = ifelse(is.na(marital_status), "Prefer Not to Say", marital_status))

cat("STEP 8k – marital_status     : NAs filled with 'Prefer Not to Say'\n")


# ------------------------------------------------------------
# STEP 8l – business_travel – mode grouped by department + job_role
# ------------------------------------------------------------
# attrition is the target variable. Rows with no value
# fallback: if the job_role+department group was entirely blank, use job_role alone
# ------------------------------------------------------------
df <- df %>%
  group_by(job_role, job_level) %>%
  mutate(business_travel = coalesce(business_travel, get_mode(business_travel))) %>%
  ungroup() %>%
  group_by(job_role) %>%
  mutate(business_travel = coalesce(business_travel, get_mode(business_travel))) %>%
  ungroup() %>%
  # final fallback: global mode
  mutate(business_travel = coalesce(business_travel, get_mode(business_travel)))


# STEP 8m – Remove rows where attrition is blank
# ------------------------------------------------------------
# attrition is the target variable. Therefore, rows with no value
# cannot be used for analysis and are dropped entirely.

n_before_attr <- nrow(df)
df <- df %>% filter(!is.na(attrition))
n_removed_attr <- n_before_attr - nrow(df)

cat("=== STEP 8m: Rows removed (attrition is blank) ===\n")
cat("Removed :", n_removed_attr, "\n")
cat("Remaining:", nrow(df), "\n\n")


# ── 8n. remaining categorical columns – global mode ──────────
other_cat <- c("over_time")

df <- df %>%
  mutate(across(all_of(other_cat),
                ~ ifelse(is.na(.), get_mode(.), .)))

cat("STEP 8n – other categorical : MODE global\n")

cat("\nTotal remaining NAs after imputation:", sum(is.na(df)), "\n\n")


# ============================================================
# STEP 8o – Post-imputation check and final fallback
# ============================================================
# Check if any NAs remain after all imputation steps.
# Apply a final global fallback to catch any rows that slipped through 
# (e.g. rows where ALL grouping columns were also blank).
# ============================================================

cat("=== STEP 8o: Post-imputation check ===\n")
remaining <- colSums(is.na(df))
if (sum(remaining) > 0) {
  cat("Columns still with NAs:\n")
  print(remaining[remaining > 0])
  
  # Final fallback: numeric -> median, character -> mode
  for (col in names(df)) {
    if (sum(is.na(df[[col]])) > 0) {
      if (is.numeric(df[[col]])) {
        df[[col]][is.na(df[[col]])] <- median(df[[col]], na.rm = TRUE)
      } else {
        df[[col]][is.na(df[[col]])] <- get_mode(df[[col]])
      }
    }
  }
}

cat("Total remaining NAs after final fallback:", sum(is.na(df)), "\n\n")


# ============================================================
# STEP 9 – Validate out-of-range values
# ============================================================
# Each coded/Likert column has a defined valid range from the
# dataset description. Any value outside the range is capped
# at the boundary (Winsorising). Rows are kept.
# ============================================================

range_rules <- list(
  education                = c(1, 5),   # 1=Below College, 5=Doctor
  environment_satisfaction  = c(1, 4),   # 1=Low, 4=Very High
  job_involvement           = c(1, 4),   # 1=Low, 4=Very High
  job_level                 = c(1, 5),   # 1 to 5
  job_satisfaction          = c(1, 4),   # 1=Low, 4=Very High
  performance_rating        = c(1, 4),   # 1=Low, 4=Outstanding
  relationship_satisfaction = c(1, 4),   # 1=Low, 4=Very High
  stock_option_level         = c(0, 3),   # 0 to 3
  work_life_balance          = c(1, 4),   # 1=Bad, 4=Best
  age                      = c(18, 65), # working age range
  percent_salary_hike        = c(11, 25), # valid hike range
  num_companies_worked       = c(0, 9),   # 0 to 9
  training_times_last_year    = c(0, 6)    # 0 to 6 sessions
)

cat("=== STEP 9: Range validation ===\n")
any_capped <- FALSE
for (col in names(range_rules)) {
  lo    <- range_rules[[col]][1]
  hi    <- range_rules[[col]][2]
  n_out <- sum(df[[col]] < lo | df[[col]] > hi, na.rm = TRUE)
  if (n_out > 0) {
    cat("  Capped", n_out, "value(s) in [", col,
        "] to range [", lo, ",", hi, "]\n")
    df[[col]] <- pmax(pmin(df[[col]], hi), lo)
    any_capped <- TRUE
  }
}
if (!any_capped) cat("  No out-of-range values detected.\n")
cat("\n")


# ============================================================
# STEP 10 – Fix logical inconsistencies between year columns
# ============================================================
# These columns must satisfy a logical hierarchy:
#
#   tota_lworking_years     <= age - 18
#     Cannot have worked more years than possible given age
#     (assuming minimum working age of 18)
#
#   years_at_company        <= total_workingy_ears
#     Cannot have been at this company longer than total career
#
#   years_in_current_role    <= years_at_company
#   years_with_curr_manager  <= years_at_company
#   years_since_last_promotion <= years_at_company
#     Cannot exceed total time spent at the company
#
# Data check found:
#    99 rows violating Rule 1
#   151 rows violating Rule 2
#   165 rows violating Rule 3 (years_in_current_role)
#   154 rows violating Rule 3 (years_with_curr_manager)
#    92 rows violating Rule 3 (years_since_last_promotion)
#
# Fix: cap the dependent column at the value of the parent
# column using pmin(). Rows are kept.
# ============================================================

# Rule 1: total_working_years cannot exceed age - 18
df <- df %>%
  mutate(total_working_years = pmin(total_working_years, age - 18))

# Rule 2: years_at_company cannot exceed total_working_years
df <- df %>%
  mutate(years_at_company = pmin(years_at_company, total_working_years))

# Rule 3: sub-company columns cannot exceed years_at_company
df <- df %>%
  mutate(
    years_in_current_role      = pmin(years_in_current_role,      years_at_company),
    years_with_curr_manager    = pmin(years_with_curr_manager,    years_at_company),
    years_since_last_promotion = pmin(years_since_last_promotion, years_at_company)
  )

cat("=== STEP 10: Logical year consistency fixed ===\n")
cat("  Rule 1: total_working_years     capped at age - 18\n")
cat("  Rule 2: years_at_company        capped at total_working_years\n")
cat("  Rule 3: years_in_current_role    capped at years_at_company\n")
cat("          years_with_curr_manager  capped at years_at_company\n")
cat("          years_since_last_promotion capped at years_at_company\n\n")


