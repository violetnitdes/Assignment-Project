# ── Load required libraries ─────────────────────────────────
library(dplyr)      # data manipulation verbs
library(stringr)    # string helper functions


# ============================================================
# STEP 1 – Import raw data
# ============================================================
# read.csv() is used to loads the CSV file.
# na.strings is used to maps blank cells and common NA labels to R's NA so that is.na() 
# can detect them consistently.
# stringsAsFactors = FALSE keeps text columns as plain character strings until 
# converting them later.
# ============================================================

df <- read.csv("~/downloads/4. dataset_employee_attrition.csv",
               stringsAsFactors = FALSE,
               na.strings        = c("", "NA", "N/A"))

cat("=== RAW DATASET ===\n")
cat("Total rows   :", nrow(df), "\n")
cat("Total columns:", ncol(df), "\n\n")


# ============================================================
# STEP 2 – Check missing values before cleaning
# ============================================================
# is.na() detects NA values, while colSums() counts the dataset per column.
# This gives a clear picture of the raw data quality before any changes are made.
# ============================================================

cat("=== STEP 2: Missing values per column (before cleaning) ===\n")
print(colSums(is.na(df)))
cat("\nTotal missing values:", sum(is.na(df)), "\n\n")


# ------------------------------------------------------------
# STEP 2b – Inspect unique values in categorical columns
# ------------------------------------------------------------
# Convert the data to lowercase before using tolower() so that the unique values
# shown here are directly matched what str_to_lower() which can produce 
# in the case_when() mappings in Step 6.
# This is the evidence that justifies every mapping used.
# ------------------------------------------------------------

cat("=== STEP 2b: Unique raw values (lowercased) per categorical column ===\n\n")

# Use the original camelCase names as they appear in the raw CSV
# (column renaming happens in Step 3, so snake_case names don't exist yet)
unq_raw <- c("Attrition", "BusinessTravel", "Department",
             "EducationField", "Gender", "JobRole",
             "MaritalStatus", "OverTime", "Over18")

for (col in unq_raw) {
  cat(col, ":\n")
  raw_vals <- df[[col]][!is.na(df[[col]])]
  sort(unique(tolower(raw_vals))) |> print()
  cat("\n")
}


# ============================================================
# STEP 3 – Standardise column names
# ============================================================
# As the standard guideline, all column names should be all lowercase with no spaces.
# tolower() is used to converts to lowercase
# gsub() replaces canany spaces with underscores.
# ============================================================

cat("=== STEP 3: Column names before standardisation ===\n")
print(names(df))

names(df) <- gsub("([a-z])([A-Z])", "\\1_\\2", colnames(df))
names(df) <- tolower(colnames(df))

cat("\nColumn names after standardisation:\n")
print(names(df))
cat("\n")


# ============================================================
# STEP 4 – Drop constant, non-related, and irrelevant columns
# ============================================================
# Constant columns (single unique value – no information):
#   over_18        – always "Y"
#   employeecount – always 1
#
# Non-related identifier column:
#   employeenumber – row ID, not a predictive feature
#
# Rate columns (not meaningful for attrition analysis):
#   hourlyrate, dailyrate, monthlyrate
# ============================================================

cols_to_drop <- c("over18", "employee_count", "employee_number",
                  "hourly_rate", "daily_rate", "monthly_rate")

df <- df %>% select(-any_of(cols_to_drop))

cat("=== STEP 4: Dropped columns ===\n")
cat(paste(" ", cols_to_drop, collapse = "\n"), "\n\n")


# ============================================================
# STEP 5 – Fix noisy numeric columns
# ============================================================
# Several numeric columns contain data-entry errors such as:
# '?' or '_' characters were appended to the number,
# e.g. "4_", "31_", "5?", "3?".
#
# Fix: str_replace_all() strips every character that is not a digit or 
# decimal point. 
# as.numeric() then coerces the cleaned string to a number.
#
# Cells that become empty after stripping are set to NA and handled in Step 8
# (imputation). Therefore, no rows are removed.
#
# Column types determined from dataset description:
#   Numerical Value columns -> numeric_cols below
#   Categorical coded columns -> handled in Step 6
# ============================================================

clean_numeric <- function(x) {
  x_clean <- str_replace_all(as.character(x), "[^0-9.]", "")
  x_clean[x_clean == ""] <- NA
  as.numeric(x_clean)
}

numeric_cols <- c(
  "age", "distance_from_home", "education",
  "environment_satisfaction",
  "job_involvement", "job_level", "job_satisfaction",
  "monthly_income", "num_companies_worked",
  "percent_salary_hike", "performance_rating",
  "relationship_satisfaction", "standard_hours", "stock_option_level",
  "total_working_years", "training_times_last_year", "work_life_balance",
  "years_at_company", "years_in_current_role",
  "years_since_last_promotion", "years_with_curr_manager"
)

df <- df %>% mutate(across(all_of(numeric_cols), clean_numeric))

cat("=== STEP 5: Stripped noise characters from",
    length(numeric_cols), "numeric columns ===\n\n")


# ============================================================
# STEP 6 – Standardise categorical column values
# ============================================================
# Each categorical column has multiple variants of the same
# value due to inconsistent data entry:
#   - Mixed case   : "yes", "YES", "Yes"
#   - Abbreviations: "ls" instead of "Life Sciences"
#   - Aliases      : "rare" instead of "Travel Rarely"
#
# Fix: str_to_lower() converts everything to lowercase first, then case_when() 
# maps every known variant to one canonical value as defined in the dataset 
# description.
# Evidence for each mapping comes from Step 2b inspection.
#
# Values that do not match with any known variant become NA and are handled in 
# Step 8. Thus, no rows are removed.
# ============================================================

# ── 6a. attrition ────────────────────────────────────────────
# Variants found in Step 2b: "0","1","no","yes"
# Dataset description: 0 = No, 1 = Yes
df <- df %>%
  mutate(attrition = case_when(
    str_to_lower(attrition) %in% c("yes", "1") ~ "Yes",
    str_to_lower(attrition) %in% c("no",  "0") ~ "No",
    TRUE ~ NA_character_
  ))

